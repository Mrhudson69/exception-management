# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgres://exmgmt:exmgmt@localhost:5433/exmgmt

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ES_EXCEPTIONS_INDEX=exceptions

# Email (SMTP) - optional. If unset, email notifications are logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Exception Platform <alerts@example.com>"

# Notifications: set to "true" to actually send to Slack/Teams/Email,
# otherwise dispatches are logged (dry-run) so the app runs without external creds.
# (The per-channel "Send test" button always attempts a real delivery.)
NOTIFICATIONS_LIVE=false

# How often the background worker checks for due escalation steps (ms).
ESCALATION_TICK_MS=15000

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
# The initial admin account is created interactively on first run (setup wizard).
